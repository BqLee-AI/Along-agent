{
  "name": "@along/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "exports": {
    ".": "./dist/main.js",
    "./client-type": {
      "types": "./dist/client-type.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "cd ../.. && bun --watch apps/api/src/main.ts",
    "seed:session": "bun src/bin/seed-session.ts",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "bun test --parallel=4 --path-ignore-patterns '**/test/integration/**' ./test",
    "test:unit": "bun test --parallel=4 --path-ignore-patterns '**/test/integration/**' ./test",
    "test:contracts": "bun test --parallel=4 ./test/contracts.test.ts",
    "test:integration": "bun test --parallel=4 --timeout 30000 ./test/integration"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "1.0.43",
    "@ai-sdk/provider": "2.0.3",
    "@along/contracts": "workspace:*",
    "@along/notifier-core": "workspace:*",
    "@along/scheduler-core": "workspace:*",
    "@along/stream-protocol": "workspace:*",
    "@along/time-core": "workspace:*",
    "@larksuiteoapi/node-sdk": "1.76.0",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/server": "2.4.0",
    "better-auth": "1.7.10",
    "elysia": "1.4.32",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/pg": "8.15.5",
    "@types/qrcode": "1.5.6",
    "typescript": "5.9.3"
  }
}
