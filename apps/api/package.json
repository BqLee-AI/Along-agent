{
  "name": "@along/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "seed:session": "tsx src/bin/seed-session.ts",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "lint": "eslint src test",
    "test": "vitest run",
    "test:unit": "vitest run --exclude test/integration/**",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "depcruise": "echo ok"
  },
  "dependencies": {
    "@along/contracts": "workspace:*",
    "@along/notifier-core": "workspace:*",
    "@along/scheduler-core": "workspace:*",
    "@along/stream-protocol": "workspace:*",
    "@along/time-core": "workspace:*",
    "better-auth": "1.7.10",
    "pg": "8.23.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/pg": "8.15.5",
    "eslint": "9.39.4",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.53.0",
    "vitest": "3.2.7"
  }
}
