{
  "name": "@along/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "cd ../.. && bun --watch apps/api/src/main.ts",
    "seed:session": "bun src/bin/seed-session.ts",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "bun test --parallel=4 --path-ignore-patterns '**/test/integration/**' ./test",
    "test:unit": "bun test --parallel=4 --path-ignore-patterns '**/test/integration/**' ./test",
    "test:contracts": "bun test --parallel=4 ./test/contracts.test.ts",
    "test:integration": "bun test --parallel=4 ./test/integration"
  },
  "dependencies": {
    "@along/contracts": "workspace:*",
    "@along/notifier-core": "workspace:*",
    "@along/scheduler-core": "workspace:*",
    "@along/stream-protocol": "workspace:*",
    "@along/time-core": "workspace:*",
    "better-auth": "1.7.10",
    "pg": "8.23.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/pg": "8.15.5",
    "typescript": "5.9.3"
  }
}
