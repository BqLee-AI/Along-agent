  "constraints": [
    {
      "table": "auth_accounts",
      "name": "auth_accounts_user_id_key",
      "type": "u",
      "columns": ["user_id"]
    },
    {
      "table": "tasks",
      "name": "tasks_source_invocation_id_fkey",
      "type": "f",
      "columns": ["source_invocation_id"],
      "target": "tool_invocations",
      "target_columns": ["invocation_id"],
      "delete_action": "r"
    },
    {
      "table": "tasks",
      "name": "tasks_source_invocation_id_uniq",
      "type": "u",
      "columns": ["source_invocation_id"]
    },
    {
      "table": "identity_account_admissions",
      "name": "identity_account_admissions_contact_generation_check",
      "type": "c",
      "columns": ["contact_generation"],
      "expression": "(contact_generation >= 0)"
    },
    {
      "table": "identity_account_admissions",
      "name": "identity_account_admissions_credential_revision_check",
      "type": "c",
      "columns": ["credential_revision"],
      "expression": "(credential_revision >= 1)"
    },
    {
      "table": "identity_account_admissions",
      "name": "identity_account_admissions_invitation_id_fkey",
      "type": "f",
      "columns": ["invitation_id"],
      "target": "identity_invitations",
      "target_columns": ["id"],
      "delete_action": "r"
    },
    {
      "table": "identity_account_admissions",
      "name": "identity_account_admissions_invitation_id_key",
      "type": "u",
      "columns": ["invitation_id"]
    },
    {
      "table": "identity_account_admissions",
      "name": "identity_account_admissions_pkey",
      "type": "p",
      "columns": ["user_id"]
    },
    {
      "table": "identity_account_admissions",
      "name": "identity_account_admissions_reset_generation_check",
      "type": "c",
      "columns": ["reset_generation"],
      "expression": "(reset_generation >= 0)"
    },
    {
      "table": "identity_account_admissions",
      "name": "identity_account_admissions_source_binding_check",
      "type": "c",
      "columns": ["source", "invitation_id"],
      "expression": "(((source = 'invitation'::text) AND (invitation_id IS NOT NULL)) OR ((source = ANY (ARRAY['installation_admin'::text, 'local_maintenance'::text])) AND (invitation_id IS NULL)))"
    },
    {
      "table": "identity_account_admissions",
      "name": "identity_account_admissions_source_check",
      "type": "c",
      "columns": ["source"],
      "expression": "(source = ANY (ARRAY['installation_admin'::text, 'invitation'::text, 'local_maintenance'::text]))"
    },
    {
      "table": "identity_account_admissions",
      "name": "identity_account_admissions_user_id_fkey",
      "type": "f",
      "columns": ["user_id"],
      "target": "users",
      "target_columns": ["id"],
      "delete_action": "r"
    },
    {
      "table": "identity_action_keys",
      "name": "identity_action_keys_action_check",
      "type": "c",
      "columns": ["action"],
      "expression": "(action = ANY (ARRAY['invite_create'::text, 'invite_resend'::text]))"
    },
    {
      "table": "identity_action_keys",
      "name": "identity_action_keys_actor_id_fkey",
      "type": "f",
      "columns": ["actor_id"],
      "target": "users",
      "target_columns": ["id"],
      "delete_action": "r"
    },
    {
      "table": "identity_action_keys",
      "name": "identity_action_keys_delivery_id_fkey",
      "type": "f",
      "columns": ["delivery_id"],
      "target": "identity_mail_deliveries",
      "target_columns": ["id"],
      "delete_action": "r"
    },
    {
      "table": "identity_action_keys",
      "name": "identity_action_keys_generation_check",
      "type": "c",
      "columns": ["generation"],
      "expression": "(generation >= 1)"
    },
    {
      "table": "identity_action_keys",
      "name": "identity_action_keys_invitation_id_fkey",
      "type": "f",
      "columns": ["invitation_id"],
      "target": "identity_invitations",
      "target_columns": ["id"],
      "delete_action": "r"
    },
    {
      "table": "identity_action_keys",
      "name": "identity_action_keys_pkey",
      "type": "p",
      "columns": ["actor_id", "action", "key"]
    },
    {
      "table": "identity_action_keys",
      "name": "identity_action_keys_replay_check",
      "type": "c",
      "columns": ["replay_until", "created_at"],
      "expression": "(replay_until >= (created_at + '7 days'::interval))"
    },
    {
      "table": "identity_action_keys",
      "name": "identity_action_keys_request_digest_check",
      "type": "c",
      "columns": ["request_digest"],
      "expression": "(octet_length(request_digest) = 32)"
    },
    {
      "table": "identity_challenges",
      "name": "identity_challenges_binding_check",
      "type": "c",
      "columns": ["purpose", "invitation_id", "user_id", "contact_revision"],
      "expression": "(((purpose = 'invitation'::text) AND (invitation_id IS NOT NULL) AND (user_id IS NULL) AND (contact_revision IS NULL)) OR ((purpose = 'verify_contact'::text) AND (invitation_id IS NULL) AND (user_id IS NOT NULL) AND (contact_revision IS NULL)) OR ((purpose = 'reset_password'::text) AND (invitation_id IS NULL) AND (user_id IS NOT NULL) AND (contact_revision IS NOT NULL)))"
    },
    {
      "table": "identity_challenges",
      "name": "identity_challenges_candidate_check",
      "type": "c",
      "columns": [
        "purpose",
        "masked_email",
        "candidate_ciphertext",
        "candidate_nonce",
        "candidate_tag",
        "encryption_key_id"
      ],
      "expression": "(((purpose = 'verify_contact'::text) AND (masked_email IS NOT NULL) AND (((candidate_ciphertext IS NOT NULL) AND (candidate_nonce IS NOT NULL) AND (octet_length(candidate_nonce) = 12) AND (candidate_tag IS NOT NULL) AND (octet_length(candidate_tag) = 16) AND (encryption_key_id IS NOT NULL)) OR ((candidate_ciphertext IS NULL) AND (candidate_nonce IS NULL) AND (candidate_tag IS NULL) AND (encryption_key_id IS NULL)))) OR ((purpose <> 'verify_contact'::text) AND (masked_email IS NULL) AND (candidate_ciphertext IS NULL) AND (candidate_nonce IS NULL) AND (candidate_tag IS NULL) AND (encryption_key_id IS NULL)))"
    },
    {
      "table": "identity_challenges",
      "name": "identity_challenges_contact_revision_check",
      "type": "c",
      "columns": ["contact_revision"],
      "expression": "(contact_revision >= 1)"
    },
    {
      "table": "identity_challenges",
      "name": "identity_challenges_expiry_check",
      "type": "c",
      "columns": ["expires_at", "created_at"],
      "expression": "(expires_at > created_at)"
    },
    {
      "table": "identity_challenges",
      "name": "identity_challenges_generation_check",
      "type": "c",
      "columns": ["generation"],
      "expression": "(generation >= 1)"
    },
    {
      "table": "identity_challenges",
      "name": "identity_challenges_invitation_id_fkey",
      "type": "f",
      "columns": ["invitation_id"],
      "target": "identity_invitations",
      "target_columns": ["id"],
      "delete_action": "r"
    },
    {
      "table": "identity_challenges",
      "name": "identity_challenges_lookup_digest_check",
      "type": "c",
      "columns": ["lookup_digest"],
      "expression": "(octet_length(lookup_digest) = 32)"
    },
    {
      "table": "identity_challenges",
      "name": "identity_challenges_pkey",
      "type": "p",
      "columns": ["id"]
    },
    {
      "table": "identity_challenges",
