  "constraints": [
    {
      "table": "harness_pauses",
      "name": "harness_pauses_reason_check",
      "type": "c",
      "columns": ["reason"],
      "expression": "(reason = 'user'::text)"
    },
    {
      "table": "harness_pauses",
      "name": "harness_pauses_purpose_check",
      "type": "c",
      "columns": ["purpose"],
      "expression": "(purpose = 'none'::text)"
    },
    {
      "table": "harness_pauses",
      "name": "harness_pauses_resume_source_check",
      "type": "c",
      "columns": ["resume_source"],
      "expression": "(resume_source = 'user'::text)"
    },
    {
      "table": "harness_pauses",
      "name": "harness_pauses_state_check",
      "type": "c",
      "columns": ["state"],
      "expression": "(state = ANY (ARRAY['pending'::text, 'paused'::text, 'consumed'::text, 'invalidated'::text]))"
    },
    {
      "table": "harness_pauses",
      "name": "harness_pauses_check",
      "type": "c",
      "columns": ["reason", "purpose", "resume_source"],
      "expression": "((reason = 'user'::text) AND (purpose = 'none'::text) AND (resume_source = 'user'::text))"
    },
    {
      "table": "harness_pauses",
      "name": "harness_pauses_check1",
      "type": "c",
      "columns": ["state", "snapshot"],
      "expression": "(((state = 'pending'::text) AND (snapshot IS NULL)) OR (state = 'invalidated'::text) OR ((state = ANY (ARRAY['paused'::text, 'consumed'::text])) AND (snapshot IS NOT NULL)))"
    },
    {
      "table": "harness_pauses",
