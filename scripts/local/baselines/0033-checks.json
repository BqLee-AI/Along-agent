      "table": "compact_freezes",
      "name": "compact_freezes_previous_revision_check",
      "type": "c",
      "columns": ["previous_revision"],
      "expression": "(previous_revision >= 0)"
    },
    {
      "table": "compact_freezes",
      "name": "compact_freezes_model_id_check",
      "type": "c",
      "columns": ["model_id"],
      "expression": "((length(model_id) >= 1) AND (length(model_id) <= 512))"
    },
    {
      "table": "compact_freezes",
      "name": "compact_freezes_prompt_revision_check",
      "type": "c",
      "columns": ["prompt_revision"],
      "expression": "((length(prompt_revision) >= 1) AND (length(prompt_revision) <= 128))"
