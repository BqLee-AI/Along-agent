  "alter_constraints": [
    {
      "table": "harness_pauses",
      "name": "harness_pauses_reason_check",
      "type": "c",
      "columns": ["reason"],
      "expression": "(reason = ANY (ARRAY['user'::text, 'runtime'::text]))"
    },
    {
      "table": "harness_pauses",
      "name": "harness_pauses_purpose_check",
      "type": "c",
      "columns": ["purpose"],
      "expression": "(purpose = ANY (ARRAY['none'::text, 'manual_compact'::text, 'automatic_compact'::text]))"
    },
    {
      "table": "harness_pauses",
      "name": "harness_pauses_resume_source_check",
      "type": "c",
      "columns": ["resume_source"],
      "expression": "(resume_source = ANY (ARRAY['user'::text, 'runtime'::text]))"
    },
    {
      "table": "harness_pauses",
      "name": "harness_pauses_check",
      "type": "c",
      "columns": ["reason", "purpose", "resume_source"],
      "expression": "(((reason = 'user'::text) AND (purpose = 'none'::text) AND (resume_source = 'user'::text)) OR ((reason = 'runtime'::text) AND (purpose = ANY (ARRAY['manual_compact'::text, 'automatic_compact'::text])) AND (resume_source = 'runtime'::text)))"
    },
    {
      "table": "harness_pause_resumes",
      "name": "harness_pause_resumes_source_check",
      "type": "c",
      "columns": ["source"],
      "expression": "(source = ANY (ARRAY['user'::text, 'runtime'::text]))"
    }
  ]
