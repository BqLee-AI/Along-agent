      "target": "messages",
      "delete_action": "r",
      "target_columns": ["id"]
    },
    {
      "table": "compact_summaries",
      "name": "compact_summaries_revision_check",
      "type": "c",
      "columns": ["revision"],
      "expression": "(revision > 0)"
