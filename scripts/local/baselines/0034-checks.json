      "type": "f",
      "columns": ["freeze_id"],
      "target": "compact_freezes",
      "delete_action": "r",
      "target_columns": ["id"]
    },
    {
      "table": "compact_operations",
      "name": "compact_operations_summary_id_fkey",
      "type": "f",
      "columns": ["summary_id"],
      "target": "compact_summaries",
      "delete_action": "r",
      "target_columns": ["id"]
    },
    {
      "table": "compact_operations",
      "name": "compact_operations_pause_id_owner_id_conversation_id_run_i_fkey",
      "type": "f",
      "columns": ["pause_id", "owner_id", "conversation_id", "run_id", "attempt_id"],
      "target": "harness_pauses",
      "delete_action": "r",
      "target_columns": ["id", "owner_id", "conversation_id", "run_id", "attempt_id"]
    },
    {
      "table": "compact_continuations",
      "name": "compact_continuations_snapshot_check",
      "type": "c",
      "columns": ["snapshot"],
      "expression": "(octet_length((snapshot)::text) <= 1048576)"
    },
    {
      "table": "compact_continuations",
      "name": "compact_continuations_context_check",
      "type": "c",
      "columns": ["context"],
      "expression": "(octet_length((context)::text) <= 1048576)"
    },
    {
      "table": "compact_continuations",
      "name": "compact_continuations_pkey",
      "type": "p",
      "columns": ["pause_id"]
    },
    {
      "table": "compact_continuations",
      "name": "compact_continuations_attempt_id_key",
      "type": "u",
      "columns": ["attempt_id"]
    }
  ],
  "triggers": [
