  "alter_constraints": [
    {
      "table": "compact_continuations",
      "name": "compact_continuations_context_check",
      "type": "c",
      "columns": ["context"],
      "expression": "\nCASE\n    WHEN (context ? 'encoding'::text) THEN ((((context ->> 'encoding'::text) = ANY (ARRAY['feishu-snapshot-aead/1'::text, 'along-office-snapshot-aead/1'::text])) AND (jsonb_typeof((context -> 'ciphertext'::text)) = 'string'::text) AND (((context - 'encoding'::text) - 'ciphertext'::text) = '{}'::jsonb) AND ((length((context ->> 'ciphertext'::text)) >= 40) AND (length((context ->> 'ciphertext'::text)) <= 1398140))) IS TRUE)\n    ELSE (octet_length((context)::text) <= 1048576)\nEND"
    },
    {
      "table": "compact_continuations",
      "name": "compact_continuations_snapshot_check",
      "type": "c",
      "columns": ["snapshot"],
      "expression": "\nCASE\n    WHEN (snapshot ? 'encoding'::text) THEN ((((snapshot ->> 'encoding'::text) = ANY (ARRAY['feishu-snapshot-aead/1'::text, 'along-office-snapshot-aead/1'::text])) AND (jsonb_typeof((snapshot -> 'ciphertext'::text)) = 'string'::text) AND (((snapshot - 'encoding'::text) - 'ciphertext'::text) = '{}'::jsonb) AND ((length((snapshot ->> 'ciphertext'::text)) >= 40) AND (length((snapshot ->> 'ciphertext'::text)) <= 1398140))) IS TRUE)\n    ELSE (octet_length((snapshot)::text) <= 1048576)\nEND"
    }
  ]
