      "expression": "((bound_conversation_id IS NULL) OR (upload_conversation_id IS NULL) OR (bound_conversation_id = upload_conversation_id))"
    },
    {
      "table": "office_attachments",
      "name": "office_attachments_check3",
      "type": "c",
      "columns": ["scope_run_id", "bound_conversation_id", "role", "format"],
      "expression": "(((scope_run_id IS NULL) AND (bound_conversation_id IS NULL) AND (role IS NULL)) OR ((scope_run_id IS NOT NULL) AND (bound_conversation_id IS NOT NULL) AND (role IS NOT NULL) AND (((role = 'notes'::text) AND (format = ANY (ARRAY['txt'::text, 'markdown'::text]))) OR ((role = 'tasks'::text) AND (format = 'csv'::text)))))"
    },
    {
      "table": "office_attachments",
      "name": "office_attachments_filename_check",
      "type": "c",
      "columns": ["filename"],
