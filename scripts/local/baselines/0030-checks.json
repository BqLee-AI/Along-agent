    },
    {
      "table": "r3_memory_revisions",
      "name": "r3_memory_revisions_revision_check",
      "type": "c",
      "columns": ["revision"],
      "expression": "(revision > 0)"
    },
    {
      "table": "r3_memory_revisions",
      "name": "r3_memory_revisions_message_ids_check",
      "type": "c",
      "columns": ["message_ids"],
      "expression": "((cardinality(message_ids) > 0) AND (array_position(message_ids, NULL::uuid) IS NULL))"
    },
    {
      "table": "r3_memory_revisions",
      "name": "r3_memory_revisions_content_check",
      "type": "c",
      "columns": ["content"],
      "expression": "((length(btrim(content)) >= 1) AND (length(btrim(content)) <= 12000))"
    },
    {
      "table": "r3_memory_revisions",
      "name": "r3_memory_revisions_source_kind_check",
      "type": "c",
      "columns": ["source_kind"],
      "expression": "(source_kind = ANY (ARRAY['explicit'::text, 'compact'::text]))"
    },
    {
      "table": "r3_memory_revisions",
      "name": "r3_memory_revisions_check",
      "type": "c",
      "columns": ["source_kind", "summary_id"],
      "expression": "((source_kind = 'compact'::text) = (summary_id IS NOT NULL))"
    },
    {
      "table": "r3_memory_revisions",
      "name": "r3_memory_revisions_pkey",
      "type": "p",
      "columns": ["owner_id", "memory_id", "revision"]
    },
    {
