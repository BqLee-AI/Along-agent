  "constraints": [
    {
      "table": "r3_memories",
      "name": "r3_memories_current_revision_check",
      "type": "c",
      "columns": ["current_revision"],
      "expression": "(current_revision > 0)"
    },
    {
      "table": "r3_memories",
      "name": "r3_memories_status_check",
      "type": "c",
      "columns": ["status"],
      "expression": "(status = ANY (ARRAY['active'::text, 'stopped'::text]))"
    },
    {
      "table": "r3_memories",
      "name": "r3_memories_pkey",
      "type": "p",
