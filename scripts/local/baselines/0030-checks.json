      "type": "f",
      "columns": ["owner_id", "memory_id"],
      "target": "r3_memories",
      "delete_action": "a",
      "target_columns": ["owner_id", "id"]
    },
    {
      "table": "r3_memories",
      "name": "r3_memories_current_revision_fk",
      "type": "f",
      "columns": ["owner_id", "id", "current_revision"],
      "deferred": true,
      "target": "r3_memory_revisions",
      "delete_action": "a",
      "target_columns": ["owner_id", "memory_id", "revision"]
    },
    {
      "table": "r3_memory_requests",
      "name": "r3_memory_requests_idempotency_key_check",
      "type": "c",
      "columns": ["idempotency_key"],
      "expression": "((length(idempotency_key) >= 1) AND (length(idempotency_key) <= 200))"
    },
    {
      "table": "r3_memory_requests",
