    "expression": "(((state = ANY (ARRAY['reserved'::text, 'unknown'::text])) AND (outcome_kind IS NULL) AND (result_version IS NULL) AND (accepted_result IS NULL) AND (approval_id IS NULL) AND (accepted_attempt_id IS NULL) AND (accepted_request_id IS NULL) AND (accepted_at IS NULL) AND (evidence_ref IS NULL)) OR ((state = 'completed'::text) AND (outcome_kind IS NOT NULL) AND (result_version = 1) AND (accepted_result IS NOT NULL) AND (jsonb_typeof(accepted_result) = 'object'::text) AND (octet_length((accepted_result)::text) <= 262144) AND (accepted_attempt_id IS NOT NULL) AND (accepted_request_id IS NOT NULL) AND (accepted_at IS NOT NULL) AND (((outcome_kind = 'approval_pending'::text) AND (approval_id IS NOT NULL)) OR ((outcome_kind <> 'approval_pending'::text) AND (approval_id IS NULL)))))"
  },
  {
