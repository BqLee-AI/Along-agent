{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://along.example/schemas/thread-stream.schema.json",
  "title": "thread-stream",
  "description": "Explicit strict v1 legacy and v2 delegation SSE envelopes, sharing seven frozen event types. v2 adds trusted start lifecycle and structurally validated terminal goal results; domain evidence and aggregate goal validity belong to the producer.",
  "type": "object",
  "oneOf": [
    { "$ref": "#/definitions/thread.started" },
    { "$ref": "#/definitions/message.delta" },
    { "$ref": "#/definitions/card.proposed" },
    { "$ref": "#/definitions/approval_required" },
    { "$ref": "#/definitions/thread.completed" },
    { "$ref": "#/definitions/thread.failed" },
    { "$ref": "#/definitions/thread.cancelled" },
    { "$ref": "#/definitions/v2.thread.started" },
    { "$ref": "#/definitions/v2.message.delta" },
    { "$ref": "#/definitions/v2.card.proposed" },
    { "$ref": "#/definitions/v2.approval_required" },
    { "$ref": "#/definitions/v2.thread.completed" },
    { "$ref": "#/definitions/v2.thread.failed" },
    { "$ref": "#/definitions/v2.thread.cancelled" }
  ],
  "definitions": {
    "envelope": {
      "type": "object",
      "required": ["protocol_version", "seq", "type", "payload", "request_id"],
      "additionalProperties": false,
      "properties": {
        "protocol_version": { "const": "v1" },
        "seq": { "type": "integer", "minimum": 1 },
        "type": {
          "enum": [
            "thread.started",
            "message.delta",
            "card.proposed",
            "approval_required",
            "thread.completed",
            "thread.failed",
            "thread.cancelled"
          ]
        },
        "payload": { "type": "object" },
        "request_id": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "thread.started": {
      "allOf": [
        { "$ref": "#/definitions/envelope" },
        {
          "type": "object",
          "required": ["payload"],
          "properties": {
            "type": { "const": "thread.started" },
            "payload": {
              "type": "object",
              "required": [
                "conversation_id",
                "run_id",
                "stream_protocol_version",
                "ruleset_id",
                "tzdb_version"
              ],
              "additionalProperties": false,
              "properties": {
                "conversation_id": { "$ref": "#/definitions/uuid" },
                "run_id": { "$ref": "#/definitions/uuid" },
                "stream_protocol_version": { "const": "v1" },
                "ruleset_id": { "type": "string", "minLength": 1, "maxLength": 200 },
                "tzdb_version": { "type": "string", "minLength": 1, "maxLength": 100 }
              }
            }
          }
        }
      ]
    },
    "message.delta": {
      "allOf": [
        { "$ref": "#/definitions/envelope" },
        {
          "type": "object",
          "required": ["payload"],
          "properties": {
            "type": { "const": "message.delta" },
            "payload": {
              "type": "object",
              "required": ["conversation_id", "run_id", "delta"],
              "additionalProperties": false,
              "properties": {
                "conversation_id": { "$ref": "#/definitions/uuid" },
                "run_id": { "$ref": "#/definitions/uuid" },
                "delta": { "type": "string", "minLength": 1, "maxLength": 4000 }
              }
            }
          }
        }
      ]
    },
    "card.proposed": {
      "allOf": [
        { "$ref": "#/definitions/envelope" },
        {
          "type": "object",
          "required": ["payload"],
          "properties": {
            "type": { "const": "card.proposed" },
            "payload": {
              "type": "object",
              "required": [
                "conversation_id",
                "run_id",
                "card_id",
                "schema_version",
                "wall_time",
                "timezone_id",
                "original_text"
              ],
              "additionalProperties": false,
              "properties": {
                "conversation_id": { "$ref": "#/definitions/uuid" },
                "run_id": { "$ref": "#/definitions/uuid" },
                "card_id": { "type": "string", "minLength": 1, "maxLength": 200 },
                "schema_version": { "const": "v1" },
                "wall_time": { "type": "string", "minLength": 1, "maxLength": 100 },
                "timezone_id": { "type": "string", "minLength": 1, "maxLength": 100 },
                "original_text": { "type": "string", "minLength": 1, "maxLength": 1000 }
              }
            }
          }
        }
      ]
    },
    "approval_required": {
      "allOf": [
        { "$ref": "#/definitions/envelope" },
        {
          "type": "object",
          "required": ["payload"],
          "properties": {
            "type": { "const": "approval_required" },
            "payload": {
              "type": "object",
              "required": [
                "conversation_id",
                "run_id",
                "approval_id",
                "card_id",
                "presentation_hash"
              ],
              "additionalProperties": false,
              "properties": {
                "conversation_id": { "$ref": "#/definitions/uuid" },
                "run_id": { "$ref": "#/definitions/uuid" },
                "approval_id": { "$ref": "#/definitions/uuid" },
                "card_id": { "type": "string", "minLength": 1, "maxLength": 200 },
                "presentation_hash": { "type": "string", "minLength": 1, "maxLength": 200 }
              }
            }
          }
        }
      ]
    },
    "thread.completed": {
      "allOf": [
        { "$ref": "#/definitions/envelope" },
        {
          "type": "object",
          "required": ["payload"],
          "properties": {
            "type": { "const": "thread.completed" },
            "payload": {
              "type": "object",
              "required": ["conversation_id", "run_id", "approval_id"],
              "additionalProperties": false,
              "properties": {
                "conversation_id": { "$ref": "#/definitions/uuid" },
                "run_id": { "$ref": "#/definitions/uuid" },
                "approval_id": { "anyOf": [{ "$ref": "#/definitions/uuid" }, { "type": "null" }] }
              }
            }
          }
        }
      ]
    },
    "thread.failed": {
      "allOf": [
        { "$ref": "#/definitions/envelope" },
        {
          "type": "object",
          "required": ["payload"],
          "properties": {
            "type": { "const": "thread.failed" },
            "payload": {
              "type": "object",
              "required": ["conversation_id", "run_id", "error"],
              "additionalProperties": false,
              "properties": {
                "conversation_id": { "$ref": "#/definitions/uuid" },
                "run_id": { "$ref": "#/definitions/uuid" },
                "error": {
                  "type": "object",
                  "required": ["code", "message", "http_status"],
                  "additionalProperties": false,
                  "properties": {
                    "code": { "type": "string", "minLength": 1, "maxLength": 100 },
                    "message": { "type": "string", "minLength": 1, "maxLength": 1000 },
                    "http_status": { "type": "integer", "minimum": 400, "maximum": 599 },
                    "details": {}
                  }
                }
              }
            }
          }
        }
      ]
    },
    "thread.cancelled": {
      "allOf": [
        { "$ref": "#/definitions/envelope" },
        {
          "type": "object",
          "required": ["payload"],
          "properties": {
            "type": { "const": "thread.cancelled" },
            "payload": {
              "type": "object",
              "required": ["conversation_id", "run_id"],
              "additionalProperties": false,
              "properties": {
                "conversation_id": { "$ref": "#/definitions/uuid" },
                "run_id": { "$ref": "#/definitions/uuid" },
                "reason": { "type": "string", "minLength": 1, "maxLength": 200 }
              }
            }
          }
        }
      ]
    },
    "envelope.v2": {
      "type": "object",
      "required": ["protocol_version", "seq", "type", "payload", "request_id"],
      "additionalProperties": false,
      "properties": {
        "protocol_version": { "const": "v2" },
        "seq": { "type": "integer", "minimum": 1 },
        "type": {
          "enum": [
            "thread.started",
            "message.delta",
            "card.proposed",
            "approval_required",
            "thread.completed",
            "thread.failed",
            "thread.cancelled"
          ]
        },
        "payload": { "type": "object" },
        "request_id": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "goalText": { "type": "string", "minLength": 1, "maxLength": 8192 },
    "goalResult": {
      "type": "object",
      "required": ["status", "outcomes", "clarification", "answer"],
      "additionalProperties": false,
      "properties": {
        "status": { "enum": ["completed", "partial", "blocked", "cancelled", "unknown"] },
        "outcomes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "required": ["description", "status", "receipt_refs"],
            "additionalProperties": false,
            "properties": {
              "description": { "$ref": "#/definitions/goalText" },
              "status": { "enum": ["achieved", "not_done", "blocked", "unknown"] },
              "receipt_refs": {
                "type": "array",
                "maxItems": 64,
                "items": { "$ref": "#/definitions/uuid" }
              },
              "create_resolution": {
                "type": "object",
                "required": [
                  "source_message_id",
                  "source_quote",
                  "zero_write_invocation_ids",
                  "created_invocation_id",
                  "read_invocation_id"
                ],
                "additionalProperties": false,
                "properties": {
                  "source_message_id": { "$ref": "#/definitions/uuid" },
                  "source_quote": { "$ref": "#/definitions/goalText" },
                  "zero_write_invocation_ids": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 64,
                    "uniqueItems": true,
                    "items": { "$ref": "#/definitions/uuid" }
                  },
                  "created_invocation_id": { "$ref": "#/definitions/uuid" },
                  "read_invocation_id": { "$ref": "#/definitions/uuid" }
                }
              }
            }
          }
        },
        "clarification": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["kind", "question"],
              "additionalProperties": false,
              "properties": {
                "kind": { "enum": ["time", "timezone", "target_selection", "destination"] },
                "question": { "$ref": "#/definitions/goalText" }
              }
            }
          ]
        },
        "answer": { "$ref": "#/definitions/goalText" }
      }
    },
    "v2.thread.started": {
      "allOf": [
        { "$ref": "#/definitions/envelope.v2" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "thread.started" },
            "payload": {
              "type": "object",
              "required": [
                "conversation_id",
                "run_id",
                "stream_protocol_version",
                "ruleset_id",
                "tzdb_version",
                "authorization_revision",
                "execution_lifecycle"
              ],
              "additionalProperties": false,
              "properties": {
                "conversation_id": { "$ref": "#/definitions/uuid" },
                "run_id": { "$ref": "#/definitions/uuid" },
                "stream_protocol_version": { "const": "v2" },
                "ruleset_id": { "type": "string", "minLength": 1, "maxLength": 200 },
                "tzdb_version": { "type": "string", "minLength": 1, "maxLength": 100 },
                "authorization_revision": { "const": "delegation/1" },
                "execution_lifecycle": { "enum": ["request-bound", "server-owned"] }
              }
            }
          }
        }
      ]
    },
    "v2.message.delta": {
      "allOf": [
        { "$ref": "#/definitions/envelope.v2" },
        { "$ref": "#/definitions/message.delta/allOf/1" }
      ]
    },
    "v2.card.proposed": {
      "allOf": [
        { "$ref": "#/definitions/envelope.v2" },
        { "$ref": "#/definitions/card.proposed/allOf/1" }
      ]
    },
    "v2.approval_required": {
      "allOf": [
        { "$ref": "#/definitions/envelope.v2" },
        { "$ref": "#/definitions/approval_required/allOf/1" }
      ]
    },
    "v2.thread.completed": {
      "allOf": [
        { "$ref": "#/definitions/envelope.v2" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "thread.completed" },
            "payload": {
              "type": "object",
              "required": ["conversation_id", "run_id", "approval_id", "goal_result"],
              "additionalProperties": false,
              "properties": {
                "conversation_id": { "$ref": "#/definitions/uuid" },
                "run_id": { "$ref": "#/definitions/uuid" },
                "approval_id": { "anyOf": [{ "$ref": "#/definitions/uuid" }, { "type": "null" }] },
                "goal_result": { "$ref": "#/definitions/goalResult" }
              }
            }
          }
        }
      ]
    },
    "v2.thread.failed": {
      "allOf": [
        { "$ref": "#/definitions/envelope.v2" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "thread.failed" },
            "payload": {
              "type": "object",
              "required": ["conversation_id", "run_id", "error", "goal_result"],
              "additionalProperties": false,
              "properties": {
                "conversation_id": { "$ref": "#/definitions/uuid" },
                "run_id": { "$ref": "#/definitions/uuid" },
                "error": {
                  "$ref": "#/definitions/thread.failed/allOf/1/properties/payload/properties/error"
                },
                "goal_result": { "$ref": "#/definitions/goalResult" }
              }
            }
          }
        }
      ]
    },
    "v2.thread.cancelled": {
      "allOf": [
        { "$ref": "#/definitions/envelope.v2" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "thread.cancelled" },
            "payload": {
              "type": "object",
              "required": ["conversation_id", "run_id", "goal_result"],
              "additionalProperties": false,
              "properties": {
                "conversation_id": { "$ref": "#/definitions/uuid" },
                "run_id": { "$ref": "#/definitions/uuid" },
                "reason": { "type": "string", "minLength": 1, "maxLength": 200 },
                "goal_result": { "$ref": "#/definitions/goalResult" }
              }
            }
          }
        }
      ]
    }
  }
}
