{
  "name": "along-agent",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "lint": "eslint . && turbo run lint",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:contracts": "turbo run test:contracts",
    "depcruise": "dependency-cruiser --config .dependency-cruiser.cjs apps packages"
  },
  "devDependencies": {
    "dependency-cruiser": "18.6.0",
    "eslint": "9.39.4",
    "turbo": "2.11.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.53.0"
  }
}
