{
  "name": "along-agent",
  "version": "0.0.0",
  "private": true,
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "scripts"
  ],
  "scripts": {
    "harness:prepare": "bash scripts/prepare-harness.sh",
    "build:harness": "bash scripts/build-harness.sh",
    "build:packages": "bun run --bun --filter './packages/*' build",
    "build:api": "bun run build:packages && bun run --bun --filter @along/api build",
    "build": "bun run build:packages && bun run --bun --filter './apps/*' build",
    "dev": "bun run build:packages && bun run --bun --parallel --filter './apps/*' dev",
    "typecheck": "bun run build:packages && bun run --bun --sequential --filter '*' typecheck",
    "lint": "oxlint .",
    "test": "bun run test:unit",
    "test:unit": "bun scripts/test-unit.mjs",
    "test:contracts": "bun run build:packages && bun test --parallel=4 ./apps/api/test/contracts.test.ts ./packages/contracts/test ./packages/stream-protocol/test",
    "test:integration": "bun run build:api && bun test --parallel=4 ./apps/api/test/integration",
    "test:scheduler": "bun run build:api && bun test --parallel=4 ./apps/api/test/integration/scheduler-fault.test.ts ./apps/api/test/integration/scheduler-schedule.test.ts ./apps/api/test/integration/tasks-cancel.test.ts ./apps/api/test/integration/scheduler-recovery.test.ts",
    "depcruise": "bun node_modules/dependency-cruiser/bin/dependency-cruiser.mjs --config .dependency-cruiser.cjs apps packages",
    "verify": "bun scripts/verify.mjs",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.3.1",
    "@types/bun": "1.4.2",
    "dependency-cruiser": "18.6.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "typescript": "5.9.3"
  }
}
